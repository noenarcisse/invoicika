{
  "imports": {
    "@models/": "./models/",
    "@data/": "./data/",
    "@helpers/*": "./helpers/*",
    "@interfaces/*": "./interfaces/*"
    
  },
  "fmt": {
    "indentWidth": 4,
    "lineWidth": 100,
    "include": [
      "**/*.ts"
    ],
    "exclude": [
      "node_modules",
      "playwright-report",
      "test-results",
      "playwright/.auth",
      "*.json",
      "*.yml",
      "*.config.ts"
    ]
  }
}